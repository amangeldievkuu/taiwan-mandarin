# Copy to .env; used by docker compose for the local PostgreSQL. Set a strong password for a
# real deployment.
POSTGRES_USER=taiwan
POSTGRES_PASSWORD=taiwan
POSTGRES_DB=taiwan_mandarin
# Host port for the database (change it if another PostgreSQL already uses 5432)
POSTGRES_PORT=5432
# Production stack (docker compose --profile app up -d --build)
WEB_PORT=8080
WEB_ORIGIN=http://localhost:8080
JWT_SECRET=
# Proxies in front of the API: 1 for the bundled nginx, 2 with a TLS proxy or tunnel in front.
TRUST_PROXY=1
# Database dumps into ./backups (the backup service): how often, and how long to keep them.
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_DAYS=14
# OpenAI: speech-to-text (pronunciation check) and the models for explain / conversation.
# Optional; without a key the AI features are off. Leave a value empty to use its default.
OPENAI_API_KEY=
# Default model and reasoning effort (none, minimal, low, medium, high, xhigh, max).
# Lower effort answers faster. Not every model takes every effort: gpt-6.1-sol and gpt-6-astra
# don't accept none (the API then falls back to low and logs which variable to change).
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=low
# Optional per-feature overrides (empty = the defaults above)
OPENAI_EXPLAIN_MODEL=
OPENAI_EXPLAIN_EFFORT=low
OPENAI_TALK_MODEL=
OPENAI_TALK_EFFORT=none
# whisper-1 gives word timestamps for tone checks; gpt-transcribe / gpt-4o-transcribe don't
OPENAI_TRANSCRIBE_MODEL=whisper-1
# auto (default); priority answers faster at a higher price, flex slower and cheaper
OPENAI_SERVICE_TIER=auto
# OPENAI_VERBOSITY=low
# Per request; raise it for slow settings (gpt-5 at medium effort can take 40 s and more)
# OPENAI_TIMEOUT_MS=45000
# OPENAI_MAX_RETRIES=1
# Daily practice reminders (Web Push). Optional; without keys the reminder settings stay hidden.
# Make a pair once with `npx web-push generate-vapid-keys` and keep them: new keys sign every device
# out of its reminders. The subject defaults to WEB_ORIGIN when it is https. Paste each key on one
# line without quotes: the public key is 87 characters, the private key 43.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
