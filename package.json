{
  "name": "taiwan-mandarin",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build:shared": "npm run build -w @taiwan-mandarin/shared",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "predev": "npm run build:shared && npm run db:up",
    "dev": "concurrently -k -n shared,api,web -c blue,magenta,green \"npm:dev -w @taiwan-mandarin/shared\" \"npm:dev -w @taiwan-mandarin/api\" \"npm:dev -w @taiwan-mandarin/web\"",
    "prebuild": "npm run build:shared",
    "build": "npm run build -w @taiwan-mandarin/api -w @taiwan-mandarin/web",
    "pretest": "npm run build:shared",
    "test": "npm run test -w @taiwan-mandarin/shared -w @taiwan-mandarin/web",
    "precheck": "npm run build:shared",
    "check": "npm run check --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
