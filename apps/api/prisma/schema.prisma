// User data only. Words, dictionary and readers are served from the generated content files
// (see src/content), so the database holds what belongs to learners.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  email              String    @unique
  passwordHash       String
  displayName        String?
  createdAt          DateTime  @default(now())
  /// Settings JSON (shared SettingsSchema) and its client timestamp, merged last-write-wins.
  settings           Json?
  settingsUpdatedAt  BigInt    @default(0)
  /// The learner's own deck: [{ id, level, addedAt }].
  deck               Json      @default("[]")
  deckUpdatedAt      BigInt    @default(0)
  /// Personal FSRS weights fitted to this user's review history.
  fsrsWeights        Float[]
  fsrsTrainedAt      DateTime?
  /// Reviews used for the last fit.
  fsrsReviewCount    Int       @default(0)
  /// Reviews there were at the last fit attempt, successful or not (the nightly job waits for more).
  fsrsAttemptedCount Int       @default(0)
  /// IANA time zone the learner last synced from, for day boundaries in server-side jobs.
  timeZone           String?
  /// Access tokens issued before this are refused (password change, sign out everywhere).
  sessionsValidFrom  DateTime?

  cards         Card[]
  reviews       ReviewLog[]
  practice      PracticeLog[]
  refreshTokens RefreshToken[]
  apiKeys       ApiKey[]
  conversations Conversation[]
  aiUsage       AiUsage[]
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 of the token; the token itself is only ever in the httpOnly cookie.
  tokenHash String    @unique
  /// Rotation chain: reusing a revoked token revokes the whole family.
  family    String    @db.Uuid
  /// The token this one replaced, so a replacement that never reached the client can be told
  /// from a replayed stolen token (see AuthService.refresh).
  parentId  String?   @db.Uuid
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  userAgent String?

  @@index([userId])
  @@index([family])
  @@index([parentId])
}

/// Personal access token for the public API ("tm_…").
model ApiKey {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  prefix     String
  keyHash    String    @unique
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  @@index([userId])
}

/// FSRS card state per user and word.
model Card {
  userId          String    @db.Uuid
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  wordId          String
  level           String?
  suspended       Boolean   @default(false)
  due             DateTime
  stability       Float
  difficulty      Float
  elapsedDays     Int
  scheduledDays   Int
  learningSteps   Int       @default(0)
  reps            Int
  lapses          Int
  state           Int
  lastReview      DateTime?
  /// Client epoch ms of the last change (last-write-wins).
  updatedAt       BigInt
  /// When the server last stored it (sync cursor).
  serverUpdatedAt DateTime  @updatedAt

  @@id([userId, wordId])
  @@index([userId, serverUpdatedAt])
}

/// Every answer, append-only. Feeds stats and the FSRS optimizer.
model ReviewLog {
  /// Client-generated UUID, so retries never duplicate a review.
  id            String   @id @db.Uuid
  userId        String   @db.Uuid
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  wordId        String
  rating        Int
  /// Card state before the review.
  state         Int
  reviewedAt    DateTime
  due           DateTime
  stability     Float
  difficulty    Float
  elapsedDays   Int
  scheduledDays Int
  durationMs    Int
  createdAt     DateTime @default(now())

  @@index([userId, reviewedAt])
  @@index([userId, wordId, reviewedAt])
  /// Sync asks which days have reviews stored since its last visit.
  @@index([userId, createdAt])
}

/// Practice away from the cards, append-only: stories read to the end, Talk messages, characters
/// written. Counted into the daily totals (XP), the same thing on the same day once.
model PracticeLog {
  /// Client-generated UUID, so retries never duplicate an entry.
  id        String   @id @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// read | talk | write
  kind      String
  /// The story id, the Talk message id or the character.
  ref       String
  at        DateTime
  createdAt DateTime @default(now())

  @@index([userId, at])
  @@index([userId, createdAt])
}

model Conversation {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  scenario  String
  level     String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  /// When the learner ended it; finished conversations are read-only.
  endedAt   DateTime?
  messages  Message[]

  @@index([userId, updatedAt])
}

model Message {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  /// Feedback on the learner's message, or new words in the assistant's.
  meta           Json?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

/// AI and speech requests per user per day, for quotas.
model AiUsage {
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  day    String
  kind   String
  count  Int    @default(0)

  @@id([userId, day, kind])
}
