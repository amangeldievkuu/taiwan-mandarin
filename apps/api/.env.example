# Copy to apps/api/.env
PORT=3000
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://taiwan:taiwan@localhost:5432/taiwan_mandarin
# 32+ random characters; required in production (openssl rand -base64 48)
JWT_SECRET=
# OpenAI: speech-to-text (pronunciation check) and the models for explain / conversation.
# Optional; without a key the AI features are off. Leave a value empty to use its default.
OPENAI_API_KEY=
# Default model and reasoning effort (none, minimal, low, medium, high, xhigh, max).
# Lower effort answers faster. Not every model takes every effort: gpt-6.1-sol and gpt-6-astra
# don't accept none (the API then falls back to low and logs which variable to change).
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=low
# Optional per-feature overrides (empty = the defaults above)
OPENAI_EXPLAIN_MODEL=
OPENAI_EXPLAIN_EFFORT=low
OPENAI_TALK_MODEL=
OPENAI_TALK_EFFORT=none
# whisper-1 gives word timestamps for tone checks; gpt-transcribe / gpt-4o-transcribe don't
OPENAI_TRANSCRIBE_MODEL=whisper-1
# auto (default); priority answers faster at a higher price, flex slower and cheaper
OPENAI_SERVICE_TIER=auto
# OPENAI_VERBOSITY=low
# Per request; raise it for slow settings (gpt-5 at medium effort can take 40 s and more)
# OPENAI_TIMEOUT_MS=45000
# OPENAI_MAX_RETRIES=1
# Daily limits per user
# AI_DAILY_LIMIT=200
# SPEECH_DAILY_LIMIT=300
# Example sentence generator (npm run examples -w @taiwan-mandarin/content)
# OPENAI_EXAMPLES_MODEL=
# OPENAI_EXAMPLES_EFFORT=medium
# Daily practice reminders (Web Push); without keys they are off. Make a pair once with
# npx web-push generate-vapid-keys (and keep it: new keys cut every device off its reminders).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A mailto: or https: contact for the push services (default: WEB_ORIGIN when it is https)
# VAPID_SUBJECT=
