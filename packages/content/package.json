{
  "name": "@taiwan-mandarin/content",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Content pipeline: TOCFL / NAER word lists, CC-CEDICT, Tatoeba → app content files.",
  "scripts": {
    "fetch": "node --conditions=source src/fetch.ts",
    "build": "node --conditions=source src/build.ts",
    "ensure": "node --conditions=source src/ensure.ts",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "examples": "node --conditions=source src/generate-examples.ts",
    "translate-vi": "node --conditions=source src/translate-vi.ts"
  },
  "dependencies": {
    "@taiwan-mandarin/shared": "*",
    "fflate": "^0.8.2",
    "openai": "^7.39.0",
    "opencc-js": "^1.4.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5"
  }
}
