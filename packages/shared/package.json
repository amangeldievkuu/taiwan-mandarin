{
  "name": "@taiwan-mandarin/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./taiwan-standard": {
      "source": "./src/taiwan-standard/index.ts",
      "types": "./dist/taiwan-standard/index.d.ts",
      "default": "./dist/taiwan-standard/index.js"
    },
    "./api": {
      "source": "./src/api/index.ts",
      "types": "./dist/api/index.d.ts",
      "default": "./dist/api/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "opencc-js": "^1.4.2",
    "zod": "^4.6.7"
  }
}
